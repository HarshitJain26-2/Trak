{
  "expo": {
    "name": "Trak",
    "slug": "trak",
    "scheme": "trak",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#071B2B",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#071B2B"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trak.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#071B2B",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.trak.app"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-font",
        {
          "fonts": []
        }
      ],
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#39FF88"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#071B2B",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f08c49a2-de31-422d-a9b8-1fb39670bac8"
      }
    }
  }
}
